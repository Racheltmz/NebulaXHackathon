# Copy to .env and fill in once the Supabase project exists (Project Settings > API / Database).
# Until these are set, the app still starts — only the endpoints that need each piece return a
# clear 503 instead of crashing (see config.py). There is no auth yet (see docs/DESIGN.md), so no
# JWT secret is needed here.

# Project Settings > API (the bare project URL, no /rest/v1/ suffix)
SUPABASE_URL=
# Project Settings > API Keys > the "secret" key (sb_secret_...) — never the publishable one
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string (URI, use the "Session pooler" one for serverless-friendly conns)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Storage bucket names (create these in Supabase Storage; defaults shown)
SUPABASE_UPLOADS_BUCKET=uploads
SUPABASE_PREDICTIONS_BUCKET=predictions

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
